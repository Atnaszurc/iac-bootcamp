# Partial backend configuration for Moto (local AWS mock).
# For a real AWS account you'd use a file with just bucket and region,
# and credentials from your environment (aws login, AWS_PROFILE, ...).

bucket = "tfstate"
region = "us-east-1"

# Moto accepts any credentials; these are not real keys
access_key = "test"
secret_key = "test"

endpoints = {
  s3 = "http://localhost:5000"
}
use_path_style              = true
skip_credentials_validation = true
skip_requesting_account_id  = true
skip_metadata_api_check     = true
