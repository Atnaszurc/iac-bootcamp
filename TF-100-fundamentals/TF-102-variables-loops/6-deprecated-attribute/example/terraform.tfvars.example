# Example terraform.tfvars file for deprecated attribute demonstration
# Copy this to terraform.tfvars and uncomment the variables you want to test

# === OPTION 1: Use NEW variables (recommended, no warnings) ===
instance_type     = "t3.small"
environment       = "staging"
enable_monitoring = true

# === OPTION 2: Use DEPRECATED variables (will show warnings) ===
# Uncomment these to see deprecation warnings:
# old_instance_type = "t2.large"
# env               = "prod"
# monitoring        = true

# === OPTION 3: Mix old and new (new takes precedence) ===
# Uncomment to test precedence:
# instance_type     = "t3.medium"  # This will be used
# old_instance_type = "t2.micro"   # This will be ignored (with warning)
# environment       = "production" # This will be used
# env               = "dev"        # This will be ignored (with warning)