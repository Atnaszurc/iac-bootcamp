# Generated by Terraform (TF-202 canary example). Don't edit by hand.
global
    log stdout format raw local0

defaults
    mode http
    log global
    timeout connect 5s
    timeout client  30s
    timeout server  30s

frontend web
    bind *:${listen_port}
    default_backend pools

backend pools
    balance roundrobin
%{ for b in backends ~}
    # pool: ${b.pool}
    server ${b.name} ${b.ip}:80 weight ${b.weight} check
%{ endfor ~}
